<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuailTracker.Analyzer.Shared.ViewModels"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             x:Class="QuailTracker.Analyzer.Shared.Views.DeploymentPlannerView"
             x:DataType="vm:DeploymentPlannerViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="8">
        <!-- Toolbar -->
        <Border Grid.Row="0" Classes="CardPanel" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Draw Area"
                            Classes="PrimaryButton"
                            Command="{Binding DrawAreaCommand}" />
                    <Button Content="Edit Corners"
                            Classes="SecondaryButton"
                            Command="{Binding EditAreaCommand}"
                            IsEnabled="{Binding HasArea}" />
                    <Button Content="Clear"
                            Classes="DangerButton"
                            Command="{Binding ClearAreaCommand}"
                            IsEnabled="{Binding HasArea}" />
                    <Border Width="1" Background="#E0E0E0" Margin="4,0" />
                    <Button Content="Plan Stations"
                            Classes="PrimaryButton"
                            Command="{Binding PlanStationsCommand}"
                            IsEnabled="{Binding HasArea}" />
                    <Button Content="Move Stations"
                            Classes="SecondaryButton"
                            Command="{Binding MoveStationsCommand}"
                            IsEnabled="{Binding HasPlan}" />
                    <Border Width="1" Background="#E0E0E0" Margin="4,0" />
                    <TextBlock Text="Max units:" VerticalAlignment="Center"
                               ToolTip.Tip="Upper bound of the station-count sweep — how many units you have to deploy." />
                    <NumericUpDown Value="{Binding MaxStations}"
                                   Minimum="3" Maximum="30" Increment="1"
                                   MinWidth="120" VerticalAlignment="Center" />
                    <CheckBox Content="Detection mode"
                              IsChecked="{Binding OptimizeForDetection}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Optimize placement so ≥1 mic hemisphere covers the area (presence surveys), instead of ≥3-station localization." />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding AreaSummary}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Map + results panel -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300">
            <Border Grid.Column="0"
                    Background="#1B1B1D"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Margin="0,0,8,0">
                <mapsui:MapControl x:Name="MapControl" />
            </Border>

            <!-- Coverage results -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Text="Coverage by station count"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />

                <TextBlock Grid.Row="1"
                           Text="{Binding PlanSummary}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource QuailPrimaryBrush}"
                           Margin="0,0,0,8"
                           IsVisible="{Binding PlanSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Localization: CRLB coverage per method -->
                <DataGrid Grid.Row="2"
                          IsVisible="{Binding !OptimizeForDetection}"
                          ItemsSource="{Binding CoverageRows}"
                          SelectedItem="{Binding SelectedRow}"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N" Binding="{Binding Stations}" Width="40" />
                        <DataGridTextColumn Header="TDOA" Binding="{Binding Tdoa}" Width="*" />
                        <DataGridTextColumn Header="Bearing" Binding="{Binding Bearing}" Width="*" />
                        <DataGridTextColumn Header="Fusion" Binding="{Binding Fusion}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Detection: ≥1-hemisphere coverage -->
                <DataGrid Grid.Row="2"
                          IsVisible="{Binding OptimizeForDetection}"
                          ItemsSource="{Binding DetectionRows}"
                          SelectedItem="{Binding SelectedDetectionRow}"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Stations" Binding="{Binding Stations}" Width="90" />
                        <DataGridTextColumn Header="Detection coverage" Binding="{Binding Coverage}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3"
                        Classes="CardPanel"
                        Margin="0,8,0,0"
                        IsVisible="{Binding TweakSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding TweakSummary}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Classes="CardPanel" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Foreground="#757575" />
        </Border>
    </Grid>
</UserControl>
